# ─── Required ────────────────────────────────────────────
# A long random string for signing session cookies
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-this-to-a-random-secret-64-chars-minimum

# ─── Stripe ──────────────────────────────────────────────
# From: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...

# From: https://dashboard.stripe.com/webhooks  (after creating the webhook)
STRIPE_WEBHOOK_SECRET=whsec_...

# From: https://dashboard.stripe.com/products
# One-time $149 lifetime access price ID
STRIPE_PRICE_ID_LIFETIME=price_...

# Recurring $29/month subscription price ID
STRIPE_PRICE_ID_MONTHLY=price_...

# ─── App URL ─────────────────────────────────────────────
# Your Railway deployment URL (set after first deploy)
# e.g. https://acq-pro-production.up.railway.app
APP_URL=https://your-app.up.railway.app

# ─── Node ────────────────────────────────────────────────
NODE_ENV=production
PORT=5000
